# Preview Dockerfile — @csb/api
# Cai dat deps trong container (better-sqlite3 prebuild cho glibc) de tranh
# xung dot native binary voi host.
FROM node:20-bookworm

WORKDIR /app

# Chi can deps cua api (flat install, khong workspace)
COPY apps/api/package.json ./package.json
RUN npm install --no-audit --no-fund

# Source da build (dist) tu host
COPY apps/api/dist ./dist

ENV PORT=4000
ENV DB_PATH=/app/data/csb.db

EXPOSE 4000
CMD ["node", "dist/index.js"]